# =====================================================================
# RepoPulse v2 Environment Configuration
# =====================================================================

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port
PORT=4000

# Client Application URL
APP_URL=http://localhost:5173

# Server API URL
API_URL=http://localhost:4000

# Application PostgreSQL database connection string (tenant-restricted with RLS)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/repopulse

# Privileged PostgreSQL database connection string (used for auth tables: users, sessions)
DATABASE_URL_AUTH=postgres://postgres:postgrespassword@localhost:5432/repopulse

# Session Cookie Name (e.g. 'sid' in dev, '__Host-sid' in production)
SESSION_COOKIE_NAME=sid

# Local Developer Login toggle (true/false) - CRASHES AT BOOT IF ENABLED IN PRODUCTION
DEV_LOGIN_ENABLED=true

# GitHub App Integration Credentials
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=repopulse-app
GITHUB_CLIENT_ID=Iv1.mockclientid12345
GITHUB_CLIENT_SECRET=mock_client_secret_67890
GITHUB_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQpNSUlFcEFJQkFBS0NB...
GITHUB_WEBHOOK_SECRET=development_webhook_secret_12345
