# RepoPulse v2 SaaS Configuration

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/repopulse

# Session & Cookie Security Keys
SESSION_SECRET=change_this_to_a_random_32_character_secret_key_in_production
COOKIE_SECRET=change_this_to_another_random_32_character_secret_key_prod

# GitHub App Integration (Required for live multi-user SaaS production)
# Leave blank to use built-in local development / demo mode
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=development_webhook_secret

# Demo Mode (enables instant preview sign-in and mock repo sync)
DEMO_MODE=true
