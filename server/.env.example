# =====================================================================
# RepoPulse v2 Server Environment Configuration
# =====================================================================

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/repopulse
DATABASE_URL_AUTH=postgres://postgres:postgrespassword@localhost:5432/repopulse

SESSION_COOKIE_NAME=sid
DEV_LOGIN_ENABLED=true

# GitHub OAuth Credentials (required for GitHub Sign-In)
GITHUB_CLIENT_ID=Iv1.mockclientid12345
GITHUB_CLIENT_SECRET=mock_client_secret_67890

# Optional GitHub App Credentials
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=your-custom-app-slug
# GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=development_webhook_secret_12345

